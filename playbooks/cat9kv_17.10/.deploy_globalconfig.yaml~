---
# =============================================================================
# deploy_globalconfig.yaml
#
#   ansible-playbook <playbook>.yaml --tags deploy   -> validate only
#   ansible-playbook <playbook>.yaml --tags deploy   -> deploy only
#   ansible-playbook <playbook>.yaml --tags deploy,validate   -> deploy and then validate
#
# Global settings. NETCONF where the YANG model supports it, CLI where it
# does not.
#
# The service lines come from group_vars/all/global_configs.yaml, and the
# SAME lists drive both deploy and validation, so the two cannot drift apart:
#   global_enabled_services                 deployed and validated
#   global_disabled_services                deployed and validated
#   global_disabled_services_unverifiable   deployed only - never printed in
#                                           "show running-config all" on
#                                           Catalyst 9000, so not validated
# A group (e.g. core_switches) can override a list, for example to keep
# "service dhcp" on where SVIs use ip helper-address (DHCP relay).
#
# NETCONF tasks use error_option: rollback-on-error, so a failed edit leaves
# nothing behind in the candidate datastore.
#
# WHY SOME TASKS RETRY
#   IOS-XE applies a NETCONF commit in the background and refuses CLI
#   configuration while it does. The first CLI task after the NETCONF tasks
#   retries (3 x 10 seconds), and the validation read retries too, but only
#   when a deploy ran in this run.
#
# NOTE: get_filter is required on every NETCONF task. See Cisco bug
# CSCwk31014.
# =============================================================================

- name: Configure and validate global settings
  hosts: all
  gather_facts: false

  tasks:

    # =========================================================================
    # DEPLOY - skipped unless --tags deploy is given
    # =========================================================================
    - name: DEPLOY - Configure the memory low watermark
      ansible.netcommon.netconf_config:
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <memory>
                <free>
                  <low-watermark>
                    <processor>{{ memory_low_watermark_processor }}</processor>
                  </low-watermark>
                </free>
              </memory>
            </native>
          </config>
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <memory/>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]

    - name: DEPLOY - Configure the clock timezone
      ansible.netcommon.netconf_config:
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <clock>
                <timezone>
                  <zone>{{ timezone_name }}</zone>
                  <hours>{{ timezone_hours }}</hours>
                  <minutes>{{ timezone_minutes }}</minutes>
                </timezone>
              </clock>
            </native>
          </config>
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <clock/>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]

    - name: DEPLOY - Configure the TCP synwait time
      ansible.netcommon.netconf_config:
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <ip>
                <tcp>
                  <synwait-time>{{ tcp_synwait_time }}</synwait-time>
                </tcp>
              </ip>
            </native>
          </config>
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <ip>
                <tcp/>
              </ip>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]

    - name: DEPLOY - Enable software auto-upgrade
      ansible.netcommon.netconf_config:
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <software>
                <auto-upgrade>
                  <enable/>
                </auto-upgrade>
              </software>
            </native>
          </config>
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <software/>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]

    - name: DEPLOY - Configure the boot system image
      ansible.netcommon.netconf_config:
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <boot>
                <system>
                  <switch xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-switch">
                    <all>
                      <boot-container>
                        <boot-filename>
                          <filename>{{ boot_system_image }}</filename>
                        </boot-filename>
                      </boot-container>
                    </all>
                  </switch>
                </system>
              </boot>
            </native>
          </config>
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <boot/>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
      register: glob_deploy
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]

    # --- CLI ---------------------------------------------------------------
    # First CLI task after the NETCONF commits: retries while the switch
    # finishes applying them.
    - name: DEPLOY - Enable the required services
      cisco.ios.ios_config:
        lines: "{{ global_enabled_services }}"
      register: glob_cli_enable
      until: glob_cli_enable is not failed
      retries: 3
      delay: 10
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]

    - name: DEPLOY - Disable unused services
      cisco.ios.ios_config:
        lines: "{{ global_disabled_services + global_disabled_services_unverifiable }}"
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]

    - name: DEPLOY - Configure IP hardening and limits
      cisco.ios.ios_config:
        lines:
          - ip options drop
          - "ip icmp rate-limit unreachable {{ icmp_unreachable_rate_limit }}"
          - "mac address-table aging-time {{ mac_aging_time }}"
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]

    - name: DEPLOY - Configure the memory reserve
      cisco.ios.ios_config:
        lines:
          - "memory reserve critical {{ memory_reserved_critical }}"
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]

    # =========================================================================
    # VALIDATE - runs by default, and after a deploy
    # =========================================================================
    # Retries only when a deploy ran in this run (glob_deploy is defined).
    - name: VALIDATE - Read the global configuration back, retries after deploy
      cisco.ios.ios_command:
        commands:
          - show running-config all | include ^service|^no service|^ip |^no ip |^memory |^clock timezone|^software |^boot system|^mac address-table aging
      register: glob_read
      until: >-
        glob_deploy is not defined
        or (glob_read is not failed
            and ('boot system' in (glob_read.stdout[0] | default(''))))
      retries: 3
      delay: 10
      ignore_errors: true
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      changed_when: false
      tags: [validate, never]

    - name: VALIDATE - Store the output as trimmed lines
      set_fact:
        glob_lines: "{{ (glob_read.stdout_lines | default([[]]))[0] | map('trim') | list }}"
      tags: [validate, never]

    # The service lists come from group_vars; the rest are built from the
    # same variables the deploy tasks use.
    # "mac address-table aging-time" is deployed but not checked.
    - name: VALIDATE - Define the expected lines
      set_fact:
        glob_checks: >-
          {{ global_enabled_services
             + global_disabled_services
             + [
                 'ip options drop',
                 'memory free low-watermark processor ' ~ memory_low_watermark_processor,
                 'memory reserve critical ' ~ memory_reserved_critical,
                 'clock timezone ' ~ timezone_name ~ ' ' ~ timezone_hours ~ ' ' ~ timezone_minutes,
                 'ip tcp synwait-time ' ~ tcp_synwait_time,
                 'ip icmp rate-limit unreachable ' ~ icmp_unreachable_rate_limit,
                 'software auto-upgrade enable',
                 'boot system switch all ' ~ boot_system_image
               ] }}
      tags: [validate, never]

    - name: VALIDATE - Check each line and record the results
      set_fact:
        validation_results: >-
          {{ validation_results | default([]) + [{
               'feature':  'global config',
               'check':    item,
               'expected': 'present',
               'actual':   'present' if item in glob_lines else 'missing',
               'result':   'PASS' if item in glob_lines else 'FAIL'
             }] }}
      loop: "{{ glob_checks }}"
      loop_control:
        label: "{{ item }}"
      tags: [validate, never]

    - name: VALIDATE - Show the result
      debug:
        msg: >-
          {{ 'PASS' if glob_failed | length == 0 else 'FAIL' }}
          ---> global config:
          {{ glob_all | length - glob_failed | length }}
          of {{ glob_all | length }} present
          {{ '' if glob_failed | length == 0
             else '- missing: ' + (glob_failed | map(attribute='check') | join('; ')) }}
      vars:
        glob_all: >-
          {{ validation_results
             | selectattr('feature', 'equalto', 'global config') | list }}
        glob_failed: >-
          {{ glob_all | selectattr('result', 'equalto', 'FAIL') | list }}
      changed_when: glob_failed | length > 0
      tags: [validate, never]
