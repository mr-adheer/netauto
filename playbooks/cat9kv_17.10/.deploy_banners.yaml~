---
# =============================================================================
# deploy_banners.yaml
#
#   ansible-playbook <playbook>.yaml --tags deploy   -> validate only
#   ansible-playbook <playbook>.yaml --tags deploy   -> deploy only
#   ansible-playbook <playbook>.yaml --tags deploy,validate   -> deploy and then validate
#
# Banners are fully supported by the YANG model, so no CLI fallback is needed.
#
# IMPORTANT: "<" and ">" inside the banner text must be XML-escaped as &lt;
# and &gt;, or avoided altogether. The banners below avoid them.
#
# $(hostname) and $(line) are Cisco banner tokens, expanded by the device at
# display time. They pass through as literal text.
#
# VALIDATION
#   Checks only that a banner is configured, not that its text is correct.
#   Comparing the text is brittle - whitespace, XML escaping and the $(hostname)
#   tokens all differ between what is sent and what the device returns.
#
#   Straight after a deploy, the read retries until the NETCONF commit has
#   synced. On a validate-only run it reads once.
#
# NOTE: get_filter is required on every NETCONF task. See Cisco bug
# CSCwk31014.
# =============================================================================

- name: Configure and validate banners
  hosts: access_switches
  gather_facts: false

  tasks:

    # =========================================================================
    # DEPLOY - skipped unless --tags deploy is given
    # =========================================================================
    - name: DEPLOY - Configure exec and login banners
      register: banner_deploy
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]
      ansible.netcommon.netconf_config:
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <banner/>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <banner>
                <exec>
                  <banner>
          |===============================  N O T I C E  ==============================
          |
          |
          |          YOU ARE LOGGED IN TO DEVICE THAT BELONGS TO {{ org_name }}
          |
          |
          |          ------   $(hostname) on line-VTY/TTY $(line)  -------
          |
          |
          |
          |         *** ACCESS TO THIS SYSTEM IS PROHIBITED UNLESS AUTHORISED ***
          |
          |        If you are not authorised please disconnect now. Any attempt for
          |        unauthorized access will be logged and appropriate legal action
          |        will be taken.
          |
          |
          |============================================================================
                  </banner>
                </exec>
                <login>
                  <banner>
          |============================================================================
          |
          |                               W A R N I N G
          |                               =============
          |
          |                          READ BEFORE PROCEEDING
          |
          |
          |         THIS SYSTEM IS THE PROPRITORY OF {{ org_name }}.
          |
          |         THIS SYSTEM IS FOR AUTHORISED USERS ONLY.
          |         UNAUTHORIZED ACCESS IS PROHIBITED.
          |
          |         YOUR ACCESS IS MONITORED FOR COMPLIANCE TO IT POLICY.
          |
          |         UNAUTHORIZED ACCESS WILL RESULT IN ACTION AS PER IT POLICY AND LAW
          |
          |============================================================================
                  </banner>
                </login>
              </banner>
            </native>
          </config>

    # =========================================================================
    # VALIDATE - runs by default, and after a deploy
    #
    # "show banner exec" and "show banner login" return the configured text,
    # or nothing at all if no banner is set.
    # =========================================================================
    - name: VALIDATE - Read the banners back, retries after deploy
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      cisco.ios.ios_command:
        commands:
          - show banner exec
          - show banner login
      register: banner_read
      # Retry only after a deploy, to wait for the NETCONF commit to sync.
      # On a validate-only run banner_deploy is undefined, so the first
      # attempt is accepted as-is and a missing banner is reported, not retried.
      until: >-
        banner_deploy is not defined
        or ((banner_read.stdout[0] | default('') | trim | length > 0)
            and (banner_read.stdout[1] | default('') | trim | length > 0))
      retries: 3
      delay: 10
      # If a banner is still missing 30 seconds after a deploy, record it as
      # MISSING in the report rather than stopping the play.
      ignore_errors: true
      changed_when: false
      tags: [validate, never]

    - name: VALIDATE - Check whether each banner is present
      set_fact:
        exec_banner_ok: "{{ (banner_read.stdout[0] | default('') | trim) | length > 0 }}"
        login_banner_ok: "{{ (banner_read.stdout[1] | default('') | trim) | length > 0 }}"
      tags: [validate, never]

    - name: VALIDATE - Show the result
      debug:
        msg: >-
          {{ 'PASS' if (exec_banner_ok | bool and login_banner_ok | bool) else 'FAIL' }}
          ---> banners:
          exec={{ 'present' if exec_banner_ok | bool else 'MISSING' }},
          login={{ 'present' if login_banner_ok | bool else 'MISSING' }}
      changed_when: not (exec_banner_ok | bool and login_banner_ok | bool)
      tags: [validate, never]

    - name: VALIDATE - Record the results
      set_fact:
        validation_results: >-
          {{ validation_results | default([]) + [
               {
                 'feature':  'banners',
                 'check':    'exec banner',
                 'expected': 'present',
                 'actual':   'present' if exec_banner_ok | bool else 'missing',
                 'result':   'PASS' if exec_banner_ok | bool else 'FAIL'
               },
               {
                 'feature':  'banners',
                 'check':    'login banner',
                 'expected': 'present',
                 'actual':   'present' if login_banner_ok | bool else 'missing',
                 'result':   'PASS' if login_banner_ok | bool else 'FAIL'
               }
             ] }}
      tags: [validate, never]
