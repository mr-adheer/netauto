---
# =============================================================================
# deploy_config_archive.yaml
#
#   ansible-playbook <playbook>.yaml --tags deploy   -> validate only
#   ansible-playbook <playbook>.yaml --tags deploy   -> deploy only
#   ansible-playbook <playbook>.yaml --tags deploy,validate   -> deploy and then validate
#
# Config archive and scheduled backups.
# NETCONF where the YANG model supports it, CLI where it does not. Each task
# carries its own connection settings.
#
# CLI is required for:
#   - kron occurrences and policy-lists (no YANG element exists)
#   - archive "hidekeys" and "maximum"  (absent from the model)
#
# WHY THE FIRST CLI TASK RETRIES
#   IOS-XE applies a NETCONF commit in the background. While that sync runs,
#   CLI configuration is refused, so the first CLI task after the NETCONF
#   commit retries for up to 30 seconds.
#
# VALIDATION
#   Reads the archive and kron sections over CLI and checks each expected
#   line. Section reads are used rather than a flat search because lines such
#   as "logging enable" and "maximum 10" are ambiguous on their own.
#
# NOTE: get_filter is required on every NETCONF task. See Cisco bug
# CSCwk31014.
# =============================================================================

- name: Configure and validate config archive
  hosts: access_switches
  gather_facts: false

  tasks:

    # =========================================================================
    # DEPLOY - skipped unless --tags deploy is given
    # =========================================================================
    - name: DEPLOY - Configure the config archive
      vars:
        ansible_connection: netconf
        ansible_port: 830
      tags: [deploy, never]
      ansible.netcommon.netconf_config:
        get_filter: |
          <filter xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <archive/>
            </native>
          </filter>
        target: candidate
        commit: true
        error_option: rollback-on-error
        content: |
          <config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
            <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
              <archive>
                <log>
                  <config>
                    <logging>
                      <enable/>
                      <size>5</size>
                    </logging>
                    <notify>
                      <syslog>
                        <contenttype>plaintext</contenttype>
                      </syslog>
                    </notify>
                  </config>
                </log>
                <path>{{ archive_path }}</path>
                <write-memory/>
                <time-period>1440</time-period>
              </archive>
            </native>
          </config>

    # --- CLI: settings the YANG model cannot hold ---------------------------
    # hidekeys and maximum do not appear in the YANG model.
    # First CLI task after the NETCONF commit, so it retries.
    - name: DEPLOY - Configure archive hidekeys and maximum
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]
      cisco.ios.ios_config:
        lines:
          - hidekeys
          - maximum 10
        parents:
          - archive
          - log config
      register: arch_cli
      until: arch_cli is not failed
      retries: 3
      delay: 10

    # No YANG element exists for kron at all.
    - name: DEPLOY - Configure kron occurrence for the monthly save
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]
      cisco.ios.ios_config:
        lines:
          - policy-list save
        parents: kron occurrence one-month at 11:59 1 recurring

    - name: DEPLOY - Configure kron occurrence for the daily backup
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]
      cisco.ios.ios_config:
        lines:
          - policy-list CONFIGURATION_BACKUP
        parents: kron occurrence Backup at 12:00 1 recurring

    - name: DEPLOY - Configure kron policy-list save
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]
      cisco.ios.ios_config:
        lines:
          - cli write
        parents: kron policy-list save

    - name: DEPLOY - Configure kron policy-list CONFIGURATION_BACKUP
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      tags: [deploy, never]
      cisco.ios.ios_config:
        lines:
          - cli archive config
        parents: kron policy-list CONFIGURATION_BACKUP

    # =========================================================================
    # VALIDATE - runs by default, and after a deploy
    # =========================================================================
    - name: VALIDATE - Read the archive and kron configuration back
      vars:
        ansible_connection: network_cli
        ansible_port: 22
      cisco.ios.ios_command:
        commands:
          - show running-config all | section ^archive$
          - show running-config all | section ^kron
      register: arch_read
      changed_when: false
      tags: [validate, never]

    - name: VALIDATE - Store each section as trimmed lines
      set_fact:
        archive_lines: "{{ arch_read.stdout_lines[0] | map('trim') | list }}"
        kron_lines: "{{ arch_read.stdout_lines[1] | map('trim') | list }}"
      tags: [validate, never]

    - name: VALIDATE - Define the expected archive and kron lines
      set_fact:
        archive_checks:
          - "logging enable"
          - "logging size 5"
          - "notify syslog contenttype plaintext"
          - "hidekeys"
          - "path {{ archive_path }}"
          - "maximum 10"
          - "time-period 1440"
          - "write-memory"
        kron_checks:
          - "kron occurrence one-month at 11:59 1 recurring"
          - "kron occurrence Backup at 12:00 1 recurring"
          - "kron policy-list save"
          - "kron policy-list CONFIGURATION_BACKUP"
          - "policy-list save"
          - "policy-list CONFIGURATION_BACKUP"
          - "cli write"
          - "cli archive config"
      tags: [validate, never]

    - name: VALIDATE - Check the archive settings and record the results
      set_fact:
        validation_results: >-
          {{ validation_results | default([]) + [{
               'feature':  'config archive',
               'check':    'archive / ' ~ item,
               'expected': 'present',
               'actual':   'present' if item in archive_lines else 'missing',
               'result':   'PASS' if item in archive_lines else 'FAIL'
             }] }}
      loop: "{{ archive_checks }}"
      loop_control:
        label: "{{ item }}"
      tags: [validate, never]

    - name: VALIDATE - Check the kron settings and record the results
      set_fact:
        validation_results: >-
          {{ validation_results | default([]) + [{
               'feature':  'config archive',
               'check':    'kron / ' ~ item,
               'expected': 'present',
               'actual':   'present' if item in kron_lines else 'missing',
               'result':   'PASS' if item in kron_lines else 'FAIL'
             }] }}
      loop: "{{ kron_checks }}"
      loop_control:
        label: "{{ item }}"
      tags: [validate, never]

    - name: VALIDATE - Show the result
      debug:
        msg: >-
          {{ 'PASS' if arch_failed | length == 0 else 'FAIL' }}
          ---> config archive:
          {{ arch_all | length - arch_failed | length }}
          of {{ arch_all | length }} present
          {{ '' if arch_failed | length == 0
             else '- missing: ' + (arch_failed | map(attribute='check') | join('; ')) }}
      vars:
        arch_all: >-
          {{ validation_results
             | selectattr('feature', 'equalto', 'config archive') | list }}
        arch_failed: >-
          {{ arch_all | selectattr('result', 'equalto', 'FAIL') | list }}
      changed_when: arch_failed | length > 0
      tags: [validate, never]
